+      <h3><?= $escape($feedbackLang->desc) ?></h3>
+      <p class="whitespace-pre-wrap"><?= $escape($feedback->desc) ?></p>
+    </section>
+    <?php if($ticket): ?>
+      <section class="border rounded p-4 mt-6">
+        <h3>#<?= (int)$ticket->id ?> <?= $escape($ticket->title) ?></h3>
