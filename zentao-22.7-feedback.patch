+
+        $data += array('status' => 'noreview', 'openedBy' => $this->app->user->account, 'openedDate' => helper::now());
+        $ownsTransaction = !$this->dbh->inTransaction();
+        if($ownsTransaction) $this->dbh->beginTransaction();
+        try
